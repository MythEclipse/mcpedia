[Unit]
Description=MCPedia API (native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory follows the PAYLOAD, not a git checkout.
#
# It was /home/code/mcpedia, a checkout that has since been deleted. The process
# kept running because nothing restarts a running process — but a reboot, a
# deploy, or an OOM kill would have left the host with no working mcpedia while
# `systemctl is-active` still reported "active" right up to that moment.
#
# It resolves the `current` symlink, not a concrete release. Naming a SHA here
# would pin the unit to one release until someone edited this file, so a deploy
# would report success while the restarted service kept running the old payload.
WorkingDirectory=/opt/mcpedia-api/current
# Secrets come from bws via bws-exec, the convention every other service on
# this host uses (hub, gmw, scraper, zeavis). It is NOT an EnvironmentFile:
#
#  - systemd loads EnvironmentFile BEFORE ExecStartPre, so an EnvironmentFile
#    cannot be produced by a wrapper that runs at ExecStart time.
#  - The old `EnvironmentFile=/home/code/mcpedia/.env` had no `-` prefix and
#    that file was deleted with the checkout, so every start died with "Failed to
#    load environment files" / result 'resources' before reaching the launcher.
#
# The API additionally REFUSES to start without WEBHOOK_SECRET, which is what
# turned the old breakage loud instead of silent.
# The app name is `mcpedia`, not `mcpedia-api`: all mcpedia secrets are
# `mcpedia_`-prefixed and bws-exec keys off that prefix. `bws-env
# mcpedia-api` exits 1 with "no secret ber-prefix 'mcpedia-api_'".
#
# ── CONTENT_ROOT is NAMED here, not left to the in-code default ──────────────
#
# `packages/config` falls back to `resolve(REPO_ROOT, "content")`, and REPO_ROOT
# is derived from the config module's own location — which is fine in a checkout
# and wrong everywhere else. The deployed bundle lives at
# /opt/mcpedia-<svc>/current/dist/index.js, so `../../..` walks to `/opt` and
# the fallback names `/opt/content`.
#
# That path cannot be created: /opt is root-owned and these units run as `code`,
# so the very first `mkdirSync` throws EACCES. The mirror call sites swallow
# their errors by design (Postgres is authoritative, the file is a backup), so
# the symptom was an API that answered 200 while the on-disk backup — the thing
# `content/` is documented to be — never existed at all.
#
# So the target is written down, where a reviewer can see it: a service-owned
# directory that survives a release swap and is not inside an artifact the
# deploy declares immutable. `scripts/deploy-direct.sh` creates it before the
# units restart; see MIRROR_ROOT there.
Environment=CONTENT_ROOT=/var/lib/mcpedia/content
ExecStart=/usr/local/bin/bws-exec mcpedia /opt/mcpedia-api/bin/mcpedia-api
Restart=always
RestartSec=5
User=code
Group=code
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
