[Unit]
Description=MCPedia Web (native, Vite SPA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory follows the payload, not a git checkout.
#
# It used to point at /home/code/mcpedia, a checkout that has since been deleted,
# so this unit could not survive a restart even though the running process had
# simply never been restarted since. A unit that cannot restart is not a unit.
# WorkingDirectory follows the PAYLOAD, not a git checkout.
#
# It was /home/code/mcpedia, a checkout that has since been deleted. The process
# kept running because nothing restarts a running process — but a reboot, a
# deploy, or an OOM kill would have left the host with no working mcpedia while
# `systemctl is-active` still reported "active" right up to that moment.
#
# It resolves the `current` symlink, not a concrete release. Naming a SHA here
# would pin the unit to one release until someone edited this file, so a deploy
# would report success while the restarted service kept running the old payload.
WorkingDirectory=/opt/mcpedia-web/current
Environment=PORT=4016
Environment=NODE_ENV=production
# DELIBERATELY NOT WRAPPED IN bws-exec, unlike the other three units.
#
# It was, and that cost a deploy. The rationale was consistency — "one convention
# means the next unit authored here cannot quietly reintroduce the deleted-.env
# dependency" — but the sentence above it already said a static SPA needs no
# secret, and a convention that buys nothing is not worth an availability
# dependency.
#
# What it bought was a failure mode. Every deploy restarts all four units at
# once, and each one called `bws secret list` against the same Bitwarden project
# at the same instant. Bitwarden rate-limited it, bws-env retried on its 2s
# backoff, and this unit sat dead for the ~24s that took. The health probe's
# budget was 10s, so the deploy declared the release unhealthy and rolled it
# back — a static file server taken down by an API call it never used.
#
# serve.mjs reads exactly two variables, PORT and HOST (apps/web/serve.mjs:38),
# and this unit sets both. So the dependency is removed rather than the probe
# widened FOR THIS UNIT. The three units that genuinely need secrets keep
# bws-exec, and the EnvironmentFile ban still holds everywhere.
ExecStart=/opt/mcpedia-web/bin/mcpedia-web
Restart=always
RestartSec=3
User=code
Group=code
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target