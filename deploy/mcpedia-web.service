# Source-of-truth copy of /etc/systemd/system/mcpedia-web.service.
#
# Installed by scripts/deploy-direct.sh during a deploy (byte-identical to the
# live unit, comments aside — that is the invariant the deploy relies on).
# The launchers these ExecStart lines point at live in /opt/mcpedia-*/bin and
# exec system Node; there is no bun and no Nix path left anywhere in them.
[Unit]
Description=MCPedia Web (native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/code/mcpedia
Environment=PORT=4016
Environment=NODE_ENV=production
EnvironmentFile=/home/code/mcpedia/.env
ExecStart=/opt/mcpedia-web/bin/mcpedia-web
Restart=always
RestartSec=3
User=code
Group=code

[Install]
WantedBy=multi-user.target
