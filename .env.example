# MCPedia environment template.
#
#   cp .env.example .env   # then fill in the values
#
# `.env` is gitignored and is the AUTHORITATIVE local config: config/index.ts
# OVERRIDES an inherited shell value with it, deliberately, so a stray
# DATABASE_URL in your shell can never point the app at the wrong database.
#
# On a deploy host there is no .env — the services take their configuration from
# the process environment, injected at runtime by bws-exec (see the ExecStart
# lines in infra/systemd/*.service). Do NOT copy this file to a deploy host.
#
# The key list below is checked against the real schema by
# packages/config/src/env-example.test.ts: a variable added to config/index.ts
# without being documented here (or vice versa) fails that test, because a
# template that silently omits a new variable is how a deploy ends up missing one.

# --- Required: the API cannot start or serve traffic without these ------------

# Postgres. Source of truth for every document, its metadata, its embeddings and
# its search vectors. Must be a postgres:// or postgresql:// URL.
#   Local: docker compose up postgres, or the shared instance.
DATABASE_URL=postgresql://mcpedia:mcpedia@127.0.0.1:5432/mcpedia

# better-auth signs session cookies with this and derives key material from it.
# There is NO default and there must never be one: a committed fallback key
# authenticates everyone on any deployment that forgot to configure it. That bug
# has already shipped here once.
#   Generate: openssl rand -hex 32   (at least 16 chars)
BETTER_AUTH_SECRET=

# The public origin, used by better-auth to derive its trusted origins. A wrong
# value here shows up as sign-in succeeding and the session not sticking.
BETTER_AUTH_URL=http://localhost:4016

# --- Required for the write path ---------------------------------------------

# Shared secret authenticating state-changing calls: the MCP document tools
# (x-webhook-secret header) and the API's write routes. Absent means the MCP
# write path is DISABLED — the designed fail-closed behaviour, not an error, so
# startup only warns about it. A deployment that intends to accept MCP writes and
# has this blank is the case that warning exists to catch.
#   Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Redis / BullMQ ----------------------------------------------------------

# The index queue. Defaults to a Tailscale address if unset, so set it explicitly
# anywhere that address is not reachable.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Namespaces every queue key. Two deployments sharing one Redis MUST differ here,
# or their index jobs will be consumed by each other's workers.
QUEUE_PREFIX=mcpedia

# --- hindsight (chunking, embeddings, ranking, revisions) --------------------

# hindsight's HTTP endpoint. It holds the ONLY ranking engine: all three search
# modes (keyword, semantic, hybrid) delegate to it, and it embeds the query
# before it can rank anything. Reached over plain HTTP with no API key, so there
# is no secret here by design — do not invent one.
# Defaults to http://127.0.0.1:8890 when unset.
HINDSIGHT_API_URL=http://127.0.0.1:8890

# Which bank holds this corpus. Defaults to "mcpedia".
#
# NOTE: "hermes-gemini" is a bank SHARED with the Hermes agents on the mesh, and
# the embedding quota is shared with them too — an agent-heavy period there shows
# up as this wiki's search degrading. NAMESPACE_TAG keeps the corpora separable
# INSIDE the bank; it does not isolate the quota.
HINDSIGHT_BANK_ID=mcpedia

# --- Paths -------------------------------------------------------------------

# Where the on-disk markdown mirror is written. The mirror is a BACKUP of
# Postgres, never the source of truth.
#
# ALWAYS SET THIS EXPLICITLY ON A DEPLOY HOST. The in-code fallback derives from
# the module's own location, which in the deployed layout
# (/opt/mcpedia-<svc>/current/dist/) resolves to /opt/content — root-owned, so
# the service user cannot create it and every mirror write fails with EACCES. The
# writer swallows that error (the database is authoritative), so a misderived
# path is SILENT: you get an empty backup directory and no complaint.
CONTENT_ROOT=./content

# --- Bootstrap ---------------------------------------------------------------

# Seeds the FIRST admin account's credential on first run. It no longer
# authenticates a web request — the HMAC cookie it used to sign is gone and the
# web app authorizes against a better-auth session. Retained because the
# documented first-run procedure uses it.
ADMIN_PASSWORD=
