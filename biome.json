{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!payload",
			"!**/.next",
			"!**/coverage",
			"!**/*.json",
			"!**/drizzle/meta",
			"!**/next-env.d.ts",
			"!**/routeTree.gen.ts",
			"!**/paraglide/generated",
			"!.claude"
		]
	},
	"formatter": {
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"indentStyle": "tab",
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "warn",
				"noUnusedFunctionParameters": "warn",
				"noUnusedVariables": "warn",
				"useExhaustiveDependencies": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noArrayIndexKey": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useTemplate": "warn",
				"useImportType": "warn"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
