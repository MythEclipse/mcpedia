{
  "name": "mcpedia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "index": "tsx scripts/indexer.ts",
    "enqueue": "tsx scripts/enqueue.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "mcp:http": "tsx apps/mcp/src/http.ts",
    "api": "tsx apps/api/src/index.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@trpc/client": "^11.18.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.10",
    "prettier": "^3.3.0",
    "tsx": "^4.20.3",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
