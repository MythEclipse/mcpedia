{
  "name": "mcpedia",
  "version": "1.0.5",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "moon run :dev",
    "build": "moon run :build",
    "build:bundles": "node scripts/build-bundles.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "moon run :typecheck",
    "index": "tsx scripts/indexer.ts",
    "enqueue": "tsx scripts/enqueue.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "mcp:http": "tsx apps/mcp/src/http.ts",
    "api": "tsx apps/api/src/index.ts",
    "db:migrate": "tsx apps/api/src/migrate.ts",
    "db:generate": "pnpm --filter @mcpedia/db db:generate",
    "db:push": "pnpm --filter @mcpedia/db db:push",
    "db:studio": "pnpm --filter @mcpedia/db db:studio",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "^5.6.0",
    "vitest": "^5.0.4"
  }
}
